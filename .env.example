# Copy to .env and fill in. Never commit .env.

API_KEY=change-me
DATABASE_URL=postgresql+asyncpg://sourcing:sourcing@localhost:5432/sourcing
CHECKPOINTER=postgres

# Without these the app still runs: rule-based parser, offline embedder, code checks only.
# GEMINI_API_KEY (from Google AI Studio) turns on: LLM request parsing and Gemini embeddings.
# The demo vendors' Gemini vectors ship in data/embeddings, so seeding makes no API calls.
GEMINI_API_KEY=
# Required whenever GEMINI_API_KEY is set. Pick a Flash or Flash-Lite model (they have a free tier);
# copy the exact model id from AI Studio.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LLM_TIMEOUT_S=30
# SDK retries on 5xx / network errors.
LLM_RETRY_ATTEMPTS=4
# Free-tier pacing: requests per minute per model (Flash-Lite free tier allows 15).
GEMINI_RPM=14
GEMINI_EMBED_RPM=90
# TypeSafe Jev: spec/fit judgments in verify + the "specific enough to quote?" check in completeness.
# Without it the pipeline runs on code checks only.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
JEV_BATCH_SIZE=25
# Routing policy, tuned by `python -m eval.tune_thresholds` on the seed set. Re-tune when data changes.
JEV_REVIEW_AT=0.25
JEV_SHORTLIST_AT=0.35
JEV_QUOTABLE_AT=0.5

# How many vendors a result lists at most.
MAX_VENDORS=10

# Load + embed data/vendors.json in the background on start if the vendors table is empty (hosts without a shell).
SEED_ON_START=false
